{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Must match the Worker name on the chainnes.com Workers page.
  "name": "chainnes",
  "compatibility_date": "2026-10-11",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "chainnes.com",
      "custom_domain": true
    }
  ]
}
